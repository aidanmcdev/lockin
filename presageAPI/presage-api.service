[Unit]
Description=Presage API Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/presageAPI
Environment=PATH=/home/ubuntu/presageAPI/venv/bin:/usr/bin
EnvironmentFile=/home/ubuntu/presageAPI/.env
ExecStart=/home/ubuntu/presageAPI/venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 --threads 4 --timeout 600 server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
